[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="Projectile"
3d_physics/layer_5="Pickup"
3d_physics/layer_6="EnemyHitbox"
3d_physics/layer_7="PlayerBoundary"
3d_render/layer_1="World"
3d_render/layer_2="Viewmodel"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=22.0
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.898, 0.867, 0.776, 1)
environment/defaults/default_environment=""
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=2
